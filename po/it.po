msgid "Flush now"
msgstr "Scrivi ora"

msgid "Writing to the drive…"
msgstr "Scrittura sul disco…"

msgid "Finishing up…"
msgstr "Ultimi passaggi…"

msgid "Data cached in memory, waiting for the kernel to write it"
msgstr "Dati in memoria, in attesa che il kernel li scriva"

msgid "Done"
msgstr "Fatto"

#. Translators: "1.20 GB of 1.45 GB on the drive"
#, javascript-format
msgid "%s of %s on the drive"
msgstr "%s di %s sul disco"

#, javascript-format
msgid "%s written to the drive"
msgstr "%s scritti sul disco"

msgid "USB Sync Complete"
msgstr "Scrittura USB completata"

#. Translators: %s is the drive name
#, javascript-format
msgid "Write cache flushed — safe to eject %s."
msgstr "Cache di scrittura svuotata: puoi espellere %s in sicurezza."
